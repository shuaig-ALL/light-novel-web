.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.crt
*.p12
*.pfx

# ==============================================================================
# 2. SQLite databases, WAL/SHM runtime files & local data mount directories
# ==============================================================================
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
/data/
backend/data/

# ==============================================================================
# 3. Uploaded light novels, covers, illustrations & media storage
# ==============================================================================
storage/
backend/storage/
uploads/
backend/uploads/
*.epub
!.gitkeep


# =============================================================================
# 私人轻小说文库 (Light Novel Library) 环境变量模板
# 复制本文件为 .env 并填入你的实际配置，重启后端服务生效（.env 已被 .gitignore 忽略）
# =============================================================================

# --- Docker 部署端口（可选，默认 8080） ---
APP_PORT=8080

# --- JWT 认证配置 ---
JWT_SECRET_KEY=replace-with-a-long-random-secret-key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- 防剧透 AI 轻小说助手（兼容 OpenAI Chat Completions 协议） ---
# 必填：填入你的模型服务 API Key
LLM_API_KEY=

# 模型接口 Base URL（无需带末尾斜杠，也无需带 /chat/completions）：
#   OpenAI 官方:      https://api.openai.com/v1
#   DeepSeek 官方:    https://api.deepseek.com/v1
#   Gemini 兼容端点:  https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=https://api.openai.com/v1

# 模型名称（示例：gpt-4o-mini / deepseek-chat / gemini-2.5-flash）
LLM_MODEL=gpt-4o-mini

# 发送给 AI 的已读章节纯文本最大字符预算（默认 24000）
LLM_MAX_CONTEXT_CHARS=24000
